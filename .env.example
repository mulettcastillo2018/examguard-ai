# Copia este archivo como .env y completa los valores.

# PostgreSQL (por ejemplo, un proyecto de Neon: https://neon.tech)
# DATABASE_URL: con pooling para la app (en Neon, el host con -pooler y &pgbouncer=true).
# DIRECT_URL: conexión directa (el mismo host sin -pooler), para las migraciones.
# connect_timeout=15: Neon suspende la base sin uso y despertarla puede pasar de los 5 s
# que Prisma espera por defecto; con 15 s la primera visita no falla.
DATABASE_URL="postgresql://usuario:clave@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://usuario:clave@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Better Auth: secreto de al menos 32 caracteres y URL pública de la aplicación.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Intentos de inicio de sesión por minuto desde una IP (solo aplica en producción). Por defecto, 5.
# AUTH_SIGNIN_MAX_PER_MINUTE="5"

# Contraseña de las cuentas de demostración (npm run db:seed) y de las pruebas E2E.
SEED_PASSWORD=""
E2E_PASSWORD=""

# Proveedor de IA (Fase 5): Claude redacta el resumen para quien revisa. Sin llave se usa
# una plantilla factual con las mismas señales.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"

# Tarea diaria (/api/cron/daily): entrega intentos vencidos y borra la evidencia por la retención.
# Vercel envía este secreto; en otro servidor, inclúyelo como "Authorization: Bearer ...".
CRON_SECRET=""

# Modo demostración (demo pública): cuentas de ejemplo al iniciar sesión, protegidas, y datos
# de ejemplo restablecidos cada noche. DEMO_PASSWORD es pública (la de SEED_PASSWORD de la demo).
# DEMO_MODE="1"
# DEMO_PASSWORD=""

# Solo detrás de un proxy que bloquea la descarga de los motores de Prisma:
# PRISMA_QUERY_ENGINE_LIBRARY="ruta/a/.prisma-engines/query_engine.dll.node"
# PRISMA_SCHEMA_ENGINE_BINARY="ruta/a/.prisma-engines/schema-engine.exe"
