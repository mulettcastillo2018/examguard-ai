// ExamGuard AI — esquema de datos.
// Fase 1: instituciones, usuarios y autenticación (Better Auth), cursos y auditoría.
// Fase 2: banco de preguntas, exámenes y ajustes por estudiante.
// Los modelos de intentos y supervisión se agregan en sus fases (ver docs/ANALISIS.md).

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: conexión con pooling para la aplicación (en Neon, con pgbouncer=true).
// DIRECT_URL: conexión directa, la que usan las migraciones.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  LONG_ANSWER
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
}

enum GradingStatus {
  PENDING_MANUAL
  GRADED
}

enum ConsentGrantor {
  STUDENT
  GUARDIAN
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum EventCategory {
  EXAM
  ACTIVITY
  FOCUS
  VISION
  AUDIO
  CONNECTION
}

enum EventSource {
  BROWSER
  SIMULATION
  SERVER
}

enum ReviewStatus {
  NOT_REQUIRED
  RECOMMENDED
  REVIEWED
}

// Decisión de quien revisa (sección 16 de la especificación). No existe "hizo trampa":
// lo más fuerte es pedir una investigación adicional, que hacen personas fuera del sistema.
enum ReviewOutcome {
  NO_IRREGULARITY
  NEEDS_INVESTIGATION
}

enum AgentRunStatus {
  SUCCESS
  ERROR
  SKIPPED
}

model Institution {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  policy    Policy?
  users     User[]
  courses   Course[]
  questions Question[]
  exams     Exam[]
  auditLogs AuditLog[]
}

// Configuración de la institución: retención de evidencia y umbrales del Rule Engine.
model Policy {
  id                    String      @id @default(cuid())
  institutionId         String      @unique
  institution           Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  evidenceRetentionDays Int         @default(30)
  ruleThresholds        Json        @default("{}")
  consentTextVersion    String      @default("2026-10-01")
  updatedAt             DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Autenticación (Better Auth). Los nombres y tipos de estos cuatro modelos son los
// que espera Better Auth 1.7; User suma rol, institución y datos de la plataforma.
// ---------------------------------------------------------------------------

model User {
  id                 String      @id @default(cuid())
  name               String
  email              String      @unique
  emailVerified      Boolean     @default(false)
  image              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  role               Role
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id])
  // Menor de edad: su consentimiento de supervisión lo otorga el acudiente.
  isMinor            Boolean     @default(false)
  active             Boolean     @default(true)
  mustChangePassword Boolean     @default(true)

  sessions                 Session[]
  accounts                 Account[]
  teaching                 CourseTeacher[]
  enrollments              Enrollment[]
  auditLogs                AuditLog[]
  questions                Question[]        @relation("QuestionOwner")
  examsCreated             Exam[]            @relation("ExamCreator")
  accommodations           Accommodation[]
  attempts                 ExamAttempt[]
  answersGraded            Answer[]          @relation("AnswerGrader")
  reviews                  Review[]
  guardianConsent          GuardianConsent?  @relation("GuardianConsentStudent")
  guardianConsentsRecorded GuardianConsent[] @relation("GuardianConsentRecorder")

  @@index([institutionId, role])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Cursos
// ---------------------------------------------------------------------------

model Course {
  id            String          @id @default(cuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id])
  name          String
  code          String
  period        String // por ejemplo "2026-2"
  createdAt     DateTime        @default(now())
  teachers      CourseTeacher[]
  enrollments   Enrollment[]
  exams         Exam[]

  @@unique([institutionId, code, period])
}

model CourseTeacher {
  courseId  String
  teacherId String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([courseId, teacherId])
  @@index([teacherId])
}

model Enrollment {
  courseId  String
  studentId String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([courseId, studentId])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Auditoría
// ---------------------------------------------------------------------------

model AuditLog {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  actorId       String?
  actor         User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String // por ejemplo USER_CREATED, LOGIN_SUCCEEDED, COURSE_CREATED
  entityType    String
  entityId      String?
  metadata      Json?
  ip            String?
  createdAt     DateTime    @default(now())

  @@index([institutionId, createdAt])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// Banco de preguntas y exámenes (Fase 2)
//
// El contenido de una pregunta se guarda igual en el banco y en el examen:
// enunciado, opciones ([{ id, label }]) y clave de respuesta por separado, para que
// la clave nunca viaje al navegador del estudiante. Al agregar una pregunta del banco
// a un examen se copia completa (ExamQuestion): editar el banco no altera exámenes, y
// publicar solo bloquea la edición. Puntajes en múltiplos de 0,25 (exactos en coma flotante).
// ---------------------------------------------------------------------------

model Question {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])
  ownerId       String
  owner         User         @relation("QuestionOwner", fields: [ownerId], references: [id])
  type          QuestionType
  prompt        String
  options       Json         @default("[]")
  answerKey     Json
  points        Float        @default(1)
  category      String?
  tags          String[]
  archivedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([institutionId, ownerId])
  @@index([ownerId, archivedAt])
}

model Exam {
  id                 String          @id @default(cuid())
  institutionId      String
  institution        Institution     @relation(fields: [institutionId], references: [id])
  courseId           String
  course             Course          @relation(fields: [courseId], references: [id])
  createdById        String
  createdBy          User            @relation("ExamCreator", fields: [createdById], references: [id])
  title              String
  description        String?
  instructions       String?
  status             ExamStatus      @default(DRAFT)
  // Ventana en la que se puede iniciar; obligatoria para publicar.
  startsAt           DateTime?
  endsAt             DateTime?
  durationMinutes    Int             @default(60)
  maxAttempts        Int             @default(1)
  shuffleQuestions   Boolean         @default(false)
  // Supervisión: cámara, micrófono y pantalla completa (requerido / opcional / apagado).
  proctoringConfig   Json            @default("{}")
  publishedAt        DateTime?
  closedAt           DateTime?
  // Las notas se ven solo cuando el docente las publica.
  resultsPublishedAt DateTime?
  // Modo demostración: el estudiante ve un simulador de eventos (marcados como simulados).
  simulationEnabled  Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  questions          ExamQuestion[]
  accommodations     Accommodation[]
  attempts           ExamAttempt[]

  @@index([courseId, status])
  @@index([institutionId, status])
}

model ExamQuestion {
  id               String       @id @default(cuid())
  examId           String
  exam             Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  sourceQuestionId String?
  position         Int
  type             QuestionType
  prompt           String
  options          Json         @default("[]")
  answerKey        Json
  points           Float        @default(1)
  answers          Answer[]

  @@index([examId, position])
}

// Ajustes razonables por estudiante y examen.
model Accommodation {
  examId       String
  studentId    String
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  extraMinutes Int      @default(0)
  cameraExempt Boolean  @default(false)
  note         String?
  updatedAt    DateTime @updatedAt

  @@id([examId, studentId])
}

// Intento de un estudiante. El servidor fija la hora límite al empezar; el navegador
// solo la muestra. Un solo dispositivo activo: el último que abre el intento.
model ExamAttempt {
  id             String             @id @default(cuid())
  examId         String
  exam           Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId      String
  student        User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  number         Int
  status         AttemptStatus      @default(IN_PROGRESS)
  startedAt      DateTime           @default(now())
  deadlineAt     DateTime
  submittedAt    DateTime?
  activeClientId String?
  // Veces que el intento pasó a otro dispositivo o pestaña (evidencia para la Fase 4).
  clientSwitches Int                @default(0)
  // Orden de las preguntas en este intento (aleatorio si el examen lo pide).
  questionOrder  String[]
  maxScore       Float
  score          Float?
  gradingStatus  GradingStatus?
  answers        Answer[]
  consent        ConsentRecord?
  proctoring     ProctoringSession?

  @@unique([examId, studentId, number])
  @@index([examId, status])
  @@index([studentId])
}

model Answer {
  id             String       @id @default(cuid())
  attemptId      String
  attempt        ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestionId String
  examQuestion   ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
  value          Json
  // Lo envía el navegador y solo puede crecer: un guardado viejo nunca pisa uno nuevo.
  version        Int          @default(1)
  savedAt        DateTime     @updatedAt
  pointsAwarded  Float?
  autoGraded     Boolean      @default(false)
  gradedById     String?
  gradedBy       User?        @relation("AnswerGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt       DateTime?
  feedback       String?

  @@unique([attemptId, examQuestionId])
}

// Consentimiento informado de cada intento: versión del texto, qué se autorizó y quién.
// grantedBy es null cuando no se autorizó cámara ni micrófono (negarse no tiene consecuencias).
model ConsentRecord {
  id          String          @id @default(cuid())
  attemptId   String          @unique
  attempt     ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  textVersion String
  camera      Boolean
  microphone  Boolean
  grantedBy   ConsentGrantor?
  grantedAt   DateTime        @default(now())
}

// Autorización del acudiente de un estudiante menor (Ley 1581 de 2012, art. 7): la registra
// la administración con el soporte que la institución conserve. Sin una vigente, el menor
// presenta sin cámara ni micrófono. Una por estudiante; registrar otra la reemplaza y
// revocarla la deja sin efecto. El historial queda en la auditoría.
model GuardianConsent {
  id           String    @id @default(cuid())
  studentId    String    @unique
  student      User      @relation("GuardianConsentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  guardianName String
  relationship String
  camera       Boolean
  microphone   Boolean
  /// Versión del aviso que se le presentó al acudiente.
  textVersion  String
  /// Dónde está el soporte (p. ej., "formato firmado, archivo de secretaría"); nunca el documento.
  evidence     String?
  recordedById String
  recordedBy   User      @relation("GuardianConsentRecorder", fields: [recordedById], references: [id])
  recordedAt   DateTime  @default(now())
  revokedAt    DateTime?

  @@index([recordedById])
}

// Supervisión de un intento: qué se autorizó y los eventos registrados. Solo hechos
// observables con su hora; ningún evento por sí solo significa nada (docs/ANALISIS.md).
model ProctoringSession {
  id                  String            @id @default(cuid())
  attemptId           String            @unique
  attempt             ExamAttempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  browser             String?
  os                  String?
  device              String?
  cameraEnabled       Boolean           @default(false)
  microphoneEnabled   Boolean           @default(false)
  fullscreenRequested Boolean           @default(false)
  reviewStatus        ReviewStatus      @default(NOT_REQUIRED)
  startedAt           DateTime          @default(now())
  endedAt             DateTime?
  // Última señal de vida de la pantalla del examen (para el monitoreo en vivo).
  lastSeenAt          DateTime?
  lastEventAt         DateTime?
  eventCount          Int               @default(0)
  // Resumen para quien revisa (se genera al abrir la revisión, a partir de las señales).
  riskSummary         String?
  riskSummaryProvider String?
  riskSummaryAt       DateTime?
  analyzedAt          DateTime?
  events              ProctoringEvent[]
  signals             RiskSignal[]
  agentRuns           AgentRun[]
  review              Review?
}

model ProctoringEvent {
  id            String            @id @default(cuid())
  sessionId     String
  session       ProctoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Lo genera el navegador: un reintento del mismo lote no duplica eventos.
  clientEventId String
  type          String
  category      EventCategory
  severity      Severity
  // Reloj del navegador corregido con el desfase medido por el servidor.
  occurredAt    DateTime
  receivedAt    DateTime          @default(now())
  durationSec   Int?
  confidence    Float?
  metadata      Json              @default("{}")
  source        EventSource       @default(BROWSER)

  @@unique([sessionId, clientEventId])
  @@index([sessionId, occurredAt])
}

// Señal para revisión: la produce una regla con los umbrales de la institución. Describe
// hechos observables y cita los eventos que la sustentan; nunca afirma intenciones.
model RiskSignal {
  id          String            @id @default(cuid())
  sessionId   String
  session     ProctoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ruleId      String
  type        String
  category    EventCategory
  severity    Severity
  confidence  Float
  explanation String
  eventIds    String[]
  windowStart DateTime
  windowEnd   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Una señal por regla y sesión: cada análisis la actualiza en lugar de duplicarla.
  @@unique([sessionId, ruleId])
  @@index([sessionId])
}

// Cada ejecución de un agente: latencia, errores, modelo y consumo de tokens.
model AgentRun {
  id           String            @id @default(cuid())
  sessionId    String
  session      ProctoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agent        String
  status       AgentRunStatus
  provider     String?
  model        String?
  latencyMs    Int
  inputTokens  Int?
  outputTokens Int?
  error        String?
  output       Json?
  createdAt    DateTime          @default(now())

  @@index([agent, createdAt])
  @@index([sessionId])
}

// Revisión humana de una sesión (Fase 6). Una por sesión: si se cambia de opinión se
// actualiza, y cada guardado queda en la auditoría con el resultado anterior.
model Review {
  id         String            @id @default(cuid())
  sessionId  String            @unique
  session    ProctoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User              @relation(fields: [reviewerId], references: [id])
  outcome    ReviewOutcome
  notes      String?
  reviewedAt DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([reviewerId])
}
