// ExamGuard AI — esquema de datos.
// Fase 1: instituciones, usuarios y autenticación (Better Auth), cursos y auditoría.
// Fase 2: banco de preguntas, exámenes y ajustes por estudiante.
// Los modelos de intentos y supervisión se agregan en sus fases (ver docs/ANALISIS.md).

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: conexión con pooling para la aplicación (en Neon, con pgbouncer=true).
// DIRECT_URL: conexión directa, la que usan las migraciones.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  LONG_ANSWER
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
}

enum GradingStatus {
  PENDING_MANUAL
  GRADED
}

enum ConsentGrantor {
  STUDENT
  GUARDIAN
}

model Institution {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  policy    Policy?
  users     User[]
  courses   Course[]
  questions Question[]
  exams     Exam[]
  auditLogs AuditLog[]
}

// Configuración de la institución: retención de evidencia y umbrales del Rule Engine.
model Policy {
  id                    String      @id @default(cuid())
  institutionId         String      @unique
  institution           Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  evidenceRetentionDays Int         @default(30)
  ruleThresholds        Json        @default("{}")
  consentTextVersion    String      @default("2026-10-01")
  updatedAt             DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Autenticación (Better Auth). Los nombres y tipos de estos cuatro modelos son los
// que espera Better Auth 1.7; User suma rol, institución y datos de la plataforma.
// ---------------------------------------------------------------------------

model User {
  id                 String      @id @default(cuid())
  name               String
  email              String      @unique
  emailVerified      Boolean     @default(false)
  image              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  role               Role
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id])
  // Menor de edad: su consentimiento de supervisión lo otorga el acudiente.
  isMinor            Boolean     @default(false)
  active             Boolean     @default(true)
  mustChangePassword Boolean     @default(true)

  sessions       Session[]
  accounts       Account[]
  teaching       CourseTeacher[]
  enrollments    Enrollment[]
  auditLogs      AuditLog[]
  questions      Question[]      @relation("QuestionOwner")
  examsCreated   Exam[]          @relation("ExamCreator")
  accommodations Accommodation[]
  attempts       ExamAttempt[]
  answersGraded  Answer[]        @relation("AnswerGrader")

  @@index([institutionId, role])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Cursos
// ---------------------------------------------------------------------------

model Course {
  id            String          @id @default(cuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id])
  name          String
  code          String
  period        String // por ejemplo "2026-2"
  createdAt     DateTime        @default(now())
  teachers      CourseTeacher[]
  enrollments   Enrollment[]
  exams         Exam[]

  @@unique([institutionId, code, period])
}

model CourseTeacher {
  courseId  String
  teacherId String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([courseId, teacherId])
  @@index([teacherId])
}

model Enrollment {
  courseId  String
  studentId String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([courseId, studentId])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Auditoría
// ---------------------------------------------------------------------------

model AuditLog {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  actorId       String?
  actor         User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String // por ejemplo USER_CREATED, LOGIN_SUCCEEDED, COURSE_CREATED
  entityType    String
  entityId      String?
  metadata      Json?
  ip            String?
  createdAt     DateTime    @default(now())

  @@index([institutionId, createdAt])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// Banco de preguntas y exámenes (Fase 2)
//
// El contenido de una pregunta se guarda igual en el banco y en el examen:
// enunciado, opciones ([{ id, label }]) y clave de respuesta por separado, para que
// la clave nunca viaje al navegador del estudiante. Al agregar una pregunta del banco
// a un examen se copia completa (ExamQuestion): editar el banco no altera exámenes, y
// publicar solo bloquea la edición. Puntajes en múltiplos de 0,25 (exactos en coma flotante).
// ---------------------------------------------------------------------------

model Question {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])
  ownerId       String
  owner         User         @relation("QuestionOwner", fields: [ownerId], references: [id])
  type          QuestionType
  prompt        String
  options       Json         @default("[]")
  answerKey     Json
  points        Float        @default(1)
  category      String?
  tags          String[]
  archivedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([institutionId, ownerId])
  @@index([ownerId, archivedAt])
}

model Exam {
  id                 String          @id @default(cuid())
  institutionId      String
  institution        Institution     @relation(fields: [institutionId], references: [id])
  courseId           String
  course             Course          @relation(fields: [courseId], references: [id])
  createdById        String
  createdBy          User            @relation("ExamCreator", fields: [createdById], references: [id])
  title              String
  description        String?
  instructions       String?
  status             ExamStatus      @default(DRAFT)
  // Ventana en la que se puede iniciar; obligatoria para publicar.
  startsAt           DateTime?
  endsAt             DateTime?
  durationMinutes    Int             @default(60)
  maxAttempts        Int             @default(1)
  shuffleQuestions   Boolean         @default(false)
  // Supervisión: cámara, micrófono y pantalla completa (requerido / opcional / apagado).
  proctoringConfig   Json            @default("{}")
  publishedAt        DateTime?
  closedAt           DateTime?
  // Las notas se ven solo cuando el docente las publica.
  resultsPublishedAt DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  questions          ExamQuestion[]
  accommodations     Accommodation[]
  attempts           ExamAttempt[]

  @@index([courseId, status])
  @@index([institutionId, status])
}

model ExamQuestion {
  id               String       @id @default(cuid())
  examId           String
  exam             Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  sourceQuestionId String?
  position         Int
  type             QuestionType
  prompt           String
  options          Json         @default("[]")
  answerKey        Json
  points           Float        @default(1)
  answers          Answer[]

  @@index([examId, position])
}

// Ajustes razonables por estudiante y examen.
model Accommodation {
  examId       String
  studentId    String
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  extraMinutes Int      @default(0)
  cameraExempt Boolean  @default(false)
  note         String?
  updatedAt    DateTime @updatedAt

  @@id([examId, studentId])
}

// Intento de un estudiante. El servidor fija la hora límite al empezar; el navegador
// solo la muestra. Un solo dispositivo activo: el último que abre el intento.
model ExamAttempt {
  id             String         @id @default(cuid())
  examId         String
  exam           Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId      String
  student        User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  number         Int
  status         AttemptStatus  @default(IN_PROGRESS)
  startedAt      DateTime       @default(now())
  deadlineAt     DateTime
  submittedAt    DateTime?
  activeClientId String?
  // Veces que el intento pasó a otro dispositivo o pestaña (evidencia para la Fase 4).
  clientSwitches Int            @default(0)
  // Orden de las preguntas en este intento (aleatorio si el examen lo pide).
  questionOrder  String[]
  maxScore       Float
  score          Float?
  gradingStatus  GradingStatus?
  answers        Answer[]
  consent        ConsentRecord?

  @@unique([examId, studentId, number])
  @@index([examId, status])
  @@index([studentId])
}

model Answer {
  id             String       @id @default(cuid())
  attemptId      String
  attempt        ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestionId String
  examQuestion   ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
  value          Json
  // Lo envía el navegador y solo puede crecer: un guardado viejo nunca pisa uno nuevo.
  version        Int          @default(1)
  savedAt        DateTime     @updatedAt
  pointsAwarded  Float?
  autoGraded     Boolean      @default(false)
  gradedById     String?
  gradedBy       User?        @relation("AnswerGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt       DateTime?
  feedback       String?

  @@unique([attemptId, examQuestionId])
}

// Consentimiento informado de cada intento: versión del texto, qué se autorizó y quién.
// grantedBy es null cuando no se autorizó cámara ni micrófono (negarse no tiene consecuencias).
model ConsentRecord {
  id          String          @id @default(cuid())
  attemptId   String          @unique
  attempt     ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  textVersion String
  camera      Boolean
  microphone  Boolean
  grantedBy   ConsentGrantor?
  grantedAt   DateTime        @default(now())
}
